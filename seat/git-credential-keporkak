#!/bin/sh
# git-credential-keporkak — a seat's credential helper for git (contracts.md §4.4, Amendment 35). A seat holds no GitHub
# token: at each use git asks this helper, and the helper asks the daemon for one, minted then for the seat's App and
# narrowed to its stage's repository. The builder puts it into the seat's home (`bin/`); the seat's environment tells
# git to use it and no other, to reach GitHub over https, and never to prompt.
#
# Usage, by git: git-credential-keporkak get|store|erase, the credential's attributes on standard input.
# `get` for https://github.com posts to $KP_HOOK_URL/hook/github-token with KP_SESSION_TOKEN as the bearer — read by
# curl from its standard input, never from its arguments — and answers `username=x-access-token` with the token as the
# password; the token is written nowhere else. With no token it says why on standard error and tells git to quit, so
# that nothing is prompted for. `store` and `erase` keep and remove nothing; another host is answered nothing.
set -u
limit=45

case "${1:-}" in
	get) ;;
	*) cat >/dev/null; exit 0 ;;
esac

protocol=
host=
while IFS= read -r line; do
	[ -n "$line" ] || break
	case $line in
		protocol=*) protocol=${line#protocol=} ;;
		host=*) host=${line#host=} ;;
	esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

none() {
	printf 'git-credential-keporkak: no GitHub token: %s\n' "$1" >&2
	printf 'quit=1\n'
	exit 1
}

[ -n "${KP_HOOK_URL:-}" ] && [ -n "${KP_SESSION_TOKEN:-}" ] || none "KP_HOOK_URL and KP_SESSION_TOKEN are not set: this is no seat's environment"
# The answer's body, then a last line: the HTTP status and curl's own error, if any.
answer=$(printf 'header = "Authorization: Bearer %s"\n' "$KP_SESSION_TOKEN" \
	| curl --silent --max-time "$limit" --config - --request POST --write-out '\n%{http_code} %{errormsg}' "$KP_HOOK_URL/hook/github-token" 2>/dev/null)
last=$(printf '%s\n' "$answer" | tail -n 1)
body=$(printf '%s\n' "$answer" | sed '$d')
status=${last%% *}
case $status in
	200) ;;
	000) none "the daemon did not answer: ${last#* }" ;;
	*) why=$(printf '%s' "$body" | jq -r 'if (.error | type) == "string" then .error elif (.error.message | type) == "string" then .error.message else empty end' 2>/dev/null)
	   none "the daemon answered $status: ${why:-no reason given}" ;;
esac
token=$(printf '%s' "$body" | jq -er '.token | select(type == "string" and . != "")' 2>/dev/null) || none "the daemon's answer holds no token"
printf 'username=x-access-token\npassword=%s\n' "$token"
