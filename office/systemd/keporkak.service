# Keporkak — the office daemon as a systemd user service of the office user (architecture.md §4).
# TEMPLATE: `just install` (scripts/install.py) replaces @DAEMON_LAUNCHER@ with the launcher it installs and
# @DAEMON_WORKING_DIRECTORY@ with the checkout it runs in, and writes the unit to ~/.config/systemd/user/
# (office/README.md). Lingering must be on, so the service survives a logout.

[Unit]
Description=Keporkak office daemon
Documentation=file://%h/Dev/keporkak/keporkak/office/README.md

[Service]
Type=simple
WorkingDirectory=@DAEMON_WORKING_DIRECTORY@
# Panda's JDK, Node and just come from mise. A user service does not read the login shell, so its PATH names the shims.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@DAEMON_LAUNCHER@
# A restart ends the daemon's seats; they are re-seated after its replay (architecture.md §4).
Restart=on-failure
# `just stop` sends SIGTERM: the daemon closes in its shutdown hook and the JVM exits 143, which is a clean stop, not a
# failure — the unit is left inactive, and is not restarted (S3.0 T6).
SuccessExitStatus=143

[Install]
WantedBy=default.target
