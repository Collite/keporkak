{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kp:record/1",
  "type": "object",
  "required": ["v", "seq", "at", "event"],
  "properties": {
    "v": {"const": 1}, "seq": {"type": "integer", "minimum": 1}, "at": {"type": "string", "format": "date-time"},
    "event": {"enum": ["delivered", "refused", "held", "expired", "transition", "fact", "op", "rules"]}
  },
  "oneOf": [
    {"properties": {"event": {"const": "delivered"},
       "id": {"type": "string"}, "to": {"type": "array", "items": {"type": "string"}},
       "woke": {"type": "array", "items": {"type": "string"}}, "class": {"enum": ["A", "B", "C"]},
       "rule": {"type": "string"}, "ticket": {"type": ["integer", "null"]},
       "counted": {"type": "object", "additionalProperties": {"type": "integer"}},
       "observed": {"type": "object"}, "attested": {"type": "array", "items": {"type": "string"}}},
     "required": ["id", "to", "class"]},
    {"properties": {"event": {"const": "refused"},
       "id": {"type": "string"}, "rule": {"type": "string"}, "requirement": {"type": "string"},
       "observed": {"type": "object"}, "refusals_today": {"type": "integer"}},
     "required": ["id", "rule", "requirement"]},
    {"properties": {"event": {"const": "held"},
       "id": {"type": "string"}, "by": {"type": "string"}, "until": {"type": "string"},
       "ticket": {"type": ["integer", "null"]}},
     "required": ["id", "by", "until"]},
    {"properties": {"event": {"const": "expired"},
       "id": {"type": "string"}, "rule": {"type": "string"}},
     "required": ["id"]},
    {"properties": {"event": {"const": "transition"},
       "machine": {"enum": ["stage", "found", "flag", "seat", "phase", "presence"]},
       "subject": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"},
       "rule": {"type": "string"}, "cause": {"type": "string"}},
     "required": ["machine", "subject", "from", "to", "cause"]},
    {"properties": {"event": {"const": "fact"},
       "fact": {"type": "string"}, "subject": {"type": "string"}, "value": {}, "evidence": {"type": "string"}},
     "required": ["fact", "subject", "value"]},
    {"properties": {"event": {"const": "op"},
       "op": {"type": "string"}, "phase": {"enum": ["requested", "ok", "failed"]},
       "cause": {"type": "string"}, "with": {"type": "object"}, "result": {"type": "object"},
       "reason": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}},
     "required": ["op", "phase", "cause"]},
    {"properties": {"event": {"const": "rules"},
       "hash": {"type": "string"}, "files": {"type": "object", "additionalProperties": {"type": "string"}}},
     "required": ["hash", "files"]}
  ]
}
